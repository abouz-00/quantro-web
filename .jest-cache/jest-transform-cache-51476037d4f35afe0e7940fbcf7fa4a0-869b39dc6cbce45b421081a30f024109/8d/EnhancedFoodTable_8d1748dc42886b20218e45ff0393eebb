it={setEditUnit}\n                formatNumber={formatNumber}\n                onContextMenu={onContextMenu}\n                activeId={activeId}\n                contextMenuOpen={contextMenuOpen}\n                setContextMenuOpen={setContextMenuOpen}\n              />\n            ))}\n          </div>\n        </SortableContext>\n        {/* No DragOverlay - visual feedback handled by .dragging-item class only */}\n      </DndContext>\n    </div>\n  );\n}\n"],
