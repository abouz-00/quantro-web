{
  "name": "quantro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean && npm run dev",
    "dev:safe": "./scripts/safe-dev-start.sh",
    "dev:check": "./scripts/check-port-3000.sh",
    "dev:forever": "nohup ./scripts/forever-dev.sh > /dev/null 2>&1 &",
    "prisma:generate": "url=\"${DATABASE_URL:-$POSTGRES_PRISMA_URL}\"; case \"$url\" in postgres://*|postgresql://*) prisma generate --schema=prisma/schema.production.prisma ;; *) prisma generate --schema=prisma/schema.prisma ;; esac",
    "build:vercel": "npm run build",
    "postinstall": "npm run prisma:generate || true",
    "dev:daemon": "./scripts/start-dev-daemon.sh start",
    "dev:stop": "./scripts/start-dev-daemon.sh stop",
    "dev:restart": "./scripts/start-dev-daemon.sh restart",
    "dev:status": "./scripts/start-dev-daemon.sh status",
    "dev:logs": "tail -f logs/forever-dev.log",
    "dev:install-service": "./scripts/install-dev-service.sh",
    "build": "npm run prisma:generate && next build",
    "build:safe": "./scripts/safe-build.sh",
    "clean": "./scripts/clean-build.sh",
    "clean:all": "./scripts/comprehensive-clean.sh",
    "maintain": "./scripts/preventive-maintenance.sh",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run test:db:setup && jest",
    "test:watch": "npm run test:db:setup && jest --watch",
    "test:coverage": "npm run test:db:setup && jest --coverage",
    "test:ci": "./scripts/ci-test-setup.sh && jest --ci --coverage --watchAll=false --forceExit --detectOpenHandles --maxWorkers=2",
    "test:fast": "./scripts/fast-test-setup.sh && jest --maxWorkers=1 --forceExit",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:db:setup": "./scripts/setup-test-db.sh",
    "test:db:reset": "rm -f ./test.db && npm run test:db:setup",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "deps:check": "npm outdated",
    "deps:update": "npm update && npm audit fix",
    "deps:update-interactive": "npx npm-check-updates --interactive",
    "deps:update-all": "npx npm-check-updates -u && npm install",
    "deps:audit": "npm audit",
    "deps:audit-fix": "npm audit fix",
    "renovate:status": "renovate-config-validator"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^13.0.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.14",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-calendar": "^6.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "resend": "6.18.1",
    "swiper": "^14.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": ">=9.39.2 <10.0.0",
    "eslint-config-next": "^16.3.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^7"
  }
}
