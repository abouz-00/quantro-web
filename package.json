{
  "name": "quantro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean && npm run dev",
    "dev:safe": "./scripts/safe-dev-start.sh",
    "dev:check": "./scripts/check-port-3000.sh",
    "dev:forever": "nohup ./scripts/forever-dev.sh > /dev/null 2>&1 &",
    "build:vercel": "prisma generate --schema=prisma/schema.production.prisma && next build",
    "postinstall": "if [ \"$VERCEL\" = \"1\" ] || [ \"$NODE_ENV\" = \"production\" ]; then prisma generate --schema=prisma/schema.production.prisma; else prisma generate --schema=prisma/schema.prisma; fi || true",
    "dev:daemon": "./scripts/start-dev-daemon.sh start",
    "dev:stop": "./scripts/start-dev-daemon.sh stop",
    "dev:restart": "./scripts/start-dev-daemon.sh restart",
    "dev:status": "./scripts/start-dev-daemon.sh status",
    "dev:logs": "tail -f logs/forever-dev.log",
    "dev:install-service": "./scripts/install-dev-service.sh",
    "build": "prisma generate --schema=prisma/schema.production.prisma && next build",
    "build:safe": "./scripts/safe-build.sh",
    "clean": "./scripts/clean-build.sh",
    "clean:all": "./scripts/comprehensive-clean.sh",
    "maintain": "./scripts/preventive-maintenance.sh",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run test:db:setup && jest",
    "test:watch": "npm run test:db:setup && jest --watch",
    "test:coverage": "npm run test:db:setup && jest --coverage",
    "test:ci": "./scripts/ci-test-setup.sh && jest --ci --coverage --watchAll=false --forceExit --detectOpenHandles --maxWorkers=2",
    "test:fast": "./scripts/fast-test-setup.sh && jest --maxWorkers=1 --forceExit",
    "test:db:setup": "./scripts/setup-test-db.sh",
    "test:db:reset": "rm -f ./test.db && npm run test:db:setup",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "deps:check": "npm outdated",
    "deps:update": "npm update && npm audit fix",
    "deps:update-interactive": "npx npm-check-updates --interactive",
    "deps:update-all": "npx npm-check-updates -u && npm install",
    "deps:audit": "npm audit",
    "deps:audit-fix": "npm audit fix",
    "renovate:status": "renovate-config-validator"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-better-sqlite3": "^7.4.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.4.27",
    "better-sqlite3": "^12.6.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.19",
    "framer-motion": "^12.35.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-calendar": "^6.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "resend": "6.9.3",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": ">=9.39.2 <10.0.0",
    "eslint-config-next": "^16.1.6",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "prisma": "^7.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
