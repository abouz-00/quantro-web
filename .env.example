# Copy to .env.local and fill in values for local development.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

# --- Required for local auth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Optional: dev-only credentials sign-in (NODE_ENV=development) ---
DEV_SIGNIN_PASSWORD=
# Comma-separated emails that bypass the beta invite table
BETA_ALLOWLIST_EMAILS=dev@quantro.local

# --- Database (defaults to SQLite in dev) ---
DATABASE_URL=file:./prisma/dev.db

# --- OAuth (optional in dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Food search APIs (optional) ---
USDA_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- Email (optional in dev — logs to console when unset) ---
RESEND_API_KEY=

# --- Rate limiting (optional in dev — in-memory fallback) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Production database (PostgreSQL / Supabase) ---
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Observability (optional) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
