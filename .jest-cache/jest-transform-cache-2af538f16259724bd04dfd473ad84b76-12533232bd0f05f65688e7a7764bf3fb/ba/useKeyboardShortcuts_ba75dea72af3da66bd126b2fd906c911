      sourcesContent: ["import { useEffect } from 'react';\n\ninterface KeyboardShortcuts {\n  onAddFood: () => void;\n  onNextDay: () => void;\n  onPreviousDay: () => void;\n  onGoToToday: () => void;\n  onCopy?: () => void;\n  onPaste?: () => void;\n  onDelete?: () => void;\n}\n\nexport const useKeyboardShortcuts = (shortcuts: KeyboardShortcuts) => {\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      // Only handle shortcuts when not in input fields\n      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {\n        return;\n      }\n\n      // Add food - Ctrl/Cmd + A\n      if (e.key === 'a' && (e.ctrlKey || e.metaKey)) {\n        e.preventDefault();\n        shortcuts.onAddFood();\n      }\n      \n      // Next day - Ctrl/Cmd + Right Arrow\n      if (e.key === 'ArrowRight' && (e.ctrlKey || e.metaKey)) {\n        e.preventDefault();\n        shortcuts.onNextDay();\n      }\n      \n      // Previous day - Ctrl/Cmd + Left Arrow\n      if (e.key === 'ArrowLeft' && (e.ctrlKey || e.metaKey)) {\n        e.preventDefault();\n        shortcuts.onPreviousDay();\n      }\n      \n      // Go to today - Ctrl/Cmd + T\n      if (e.key === 't' && (e.ctrlKey || e.metaKey)) {\n        e.preventDefault();\n        shortcuts.onGoToToday();\n      }\n\n      // Copy - Ctrl/Cmd + C\n      if ((e.ctrlKey || e.metaKey) && e.key === 'c' && shortcuts.onCopy) {\n        e.preventDefault();\n        shortcuts.onCopy();\n      }\n\n      // Paste - Ctrl/Cmd + V\n      if ((e.ctrlKey || e.metaKey) && e.key === 'v' && shortcuts.onPaste) {\n        e.preventDefault();\n        shortcuts.onPaste();\n      }\n\n      // Delete - Delete or Backspace\n      if ((e.key === 'Delete' || e.key === 'Backspace') && shortcuts.onDelete) {\n        e.preventDefault();\n        shortcuts.onDelete();\n      }\n    };\n    \n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyD