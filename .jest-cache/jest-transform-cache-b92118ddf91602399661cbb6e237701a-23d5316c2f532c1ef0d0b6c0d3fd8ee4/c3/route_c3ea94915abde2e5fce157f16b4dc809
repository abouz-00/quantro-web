      sourcesContent: ["import { NextRequest, NextResponse } from 'next/server';\nimport { auth } from '@/lib/auth';\nimport { prisma } from '@/lib/prisma';\n\ninterface DebugResponse {\n  timestamp: string;\n  session: {\n    exists: boolean;\n    userId: string | null;\n    userEmail: string | null;\n  };\n  database: {\n    connected: boolean;\n    userExists: boolean;\n    foodLogCount: number;\n    recentEntries: Array<{\n      id: string;\n      foodName: string;\n      date: Date;\n      calories: number;\n      createdAt: Date;\n    }>;\n    error?: string;\n  };\n  environment: {\n    nodeEnv: string | undefined;\n    databaseUrl: string;\n  };\n}\n\n// eslint-disable-next-line @typescript-eslint/no-unused-vars\nexport async function GET(request: NextRequest) {\n  try {\n    console.log('\uD83E\uDDEA Debug API called');\n    \n    // Check session\n    const session = await auth();\n    console.log('\uD83E\uDDEA Session check:', session?.user?.id ? `User ID: ${session.user.id}` : 'No session');\n    \n    const response: DebugResponse = {\n      timestamp: new Date().toISOString(),\n      session: {\n        exists: !!session,\n        userId: session?.user?.id || null,\n        userEmail: session?.user?.email || null\n      },\n      database: {\n        connected: false,\n        userExists: false,\n        foodLogCount: 0,\n        recentEntries: []\n      },\n      environment: {\n        nodeEnv: process.env.NODE_ENV,\n        databaseUrl: process.env.DATABASE_URL ? 'configured' : 'missing'\n      }\n    };\n\n    // Test database connection\n    try {\n      await prisma.$connect();\n      response.database.connected = true;\n      console.log('\uD83E\uDDEA Database connected');\n\n      // Check if user exists in database\n      if (session?.user?.id) {\n        const user = await prisma.user.findUnique({\n          where: { id: session.user.id }\n        });\n        response.database.userExists = !!user;\n        console.log('\uD83E\uDDEA User exists in DB:', !!user);\n\n        if (user) {\n          // Get food log count for user\n          const foodLogCount = await prisma.foodLog.count({\n            where: { userId: session.user.id }\n          });\n          response.database.foodLogCount = foodLogCount;\n          console.log('\uD83E\uDDEA User food log count:', foodLogCount);\n\n          // Get recent entries\n          const recentEntries = await prisma.foodLog.findMany({\n            where: { userId: session.user.id },\n            orderBy: { createdAt: 'desc' },\n            take: 5,\n            select: {\n              id: true,\n              foodName: true,\n              date: true,\n              calories: true,\n              createdAt: true\n            }\n          });\n          response.database.recentEntries = recentEntries;\n          console.log('\uD83E\uDDEA Recent entries:', recentEntries.length);\n        }\n      }\n    } catch (dbError) {\n      console.error('\uD83E\uDDEA Database error:', dbError);\n      response.database = {\n        connected: false,\n        userExists: false,\n        foodLogCount: 0,\n        recentEntries: [],\n        error: dbError instanceof Error ? dbError.message : 'Unknown database error'\n      } as typeof response.database;\n    }\n\n    console.log('\uD83E\uDDEA Debug response:', response);\n    return NextResponse.json(response);\n  } catch (error) {\n    console.error('\uD83E\uDDEA Debug API error:', error);\n    return NextResponse.json({ \n      error: 'Debug API failed',\n      details: error instanceof Error ? error.message : 'Unknown error'\n    }, { status: 500 });\n  }\n}\n"],
