iresAt: null,\n            },\n            'used-code': {\n              id: 'invite-789',\n              email: 'used@example.com',\n              code: 'used-code',\n              used: true,\n              revoked: false,\n              createdAt: new Date('2025-01-01'),\n              expiresAt: new Date('2025-12-31'),\n            },\n            'revoked-code': {\n              id: 'invite-101',\n              email: 'revoked@example.com',\n              code: 'revoked-code',\n              used: false,\n              revoked: true,\n              createdAt: new Date('2025-01-01'),\n              expiresAt: new Date('2025-12-31'),\n            },\n            'expired-code': {\n              id: 'invite-202',\n              email: 'expired@example.com',\n              code: 'expired-code',\n              used: false,\n              revoked: false,\n              createdAt: new Date('2025-01-01'),\n              expiresAt: new Date('2024-12-31'), // Expired\n            },\n          };\n\n          const invite = mockInvites[code];\n          \n          if (!invite) {\n            return Promise.resolve(null);\n          }\n\n          // Check conditions\n          if (used !== false || revoked !== false) {\n            return Promise.resolve(null);\n          }\n\n          // Check expiration\n          if (OR && OR.length > 0) {\n            const now = new Date();\n            const isValidExpiration = OR.some(condition => {\n              if (condition.expiresAt === null) {\n                return invite.expiresAt === null;\n              }\n              if (condition.expiresAt?.gt) {\n                return invite.expiresAt === null || invite.expiresAt > now;\n              }\n              return true;\n            });\n            \n            if (!isValidExpiration) {\n              return Promise.resolve(null);\n            }\n          }\n\n          return Promise.resolve(invite);\n        }\n        \n        return Promise.resolve(null);\n   