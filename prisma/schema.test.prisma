// Test Prisma schema file for local testing
// This uses SQLite for faster test database operations

generator client {
  provider = "prisma-client-js"
  // Use default output for tests to avoid conflicts
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isApproved    Boolean   @default(false)
  isAdmin       Boolean   @default(false)
  invitedBy     String?
  accounts      Account[]
  sessions      Session[]
  
  // Quantro specific fields
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Email preferences
  emailUnsubscribed Boolean @default(false)

  // Nutrition tracking preferences
  dailyCalorieGoal    Int?      @default(2000)
  dailyProteinGoal    Float?    @default(150)
  dailyCarbGoal       Float?    @default(250)
  dailyFatGoal        Float?    @default(67)
  
  // User preferences
  weightUnit          String    @default("lbs") // "lbs" or "kg"
  heightUnit          String    @default("ft")  // "ft" or "cm"
  
  // Food logs
  foodLogs            FoodLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BetaInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String   @unique
  used      Boolean  @default(false)
  usedAt    DateTime?
  revoked   Boolean  @default(false)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  mealType    String   // "breakfast", "lunch", "dinner", "snack"
  orderIndex  Int?     // For drag and drop ordering within a day
  
  // Food details
  foodName    String
  brand       String?
  quantity    Float
  unit        String
  
  // Nutritional information
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sugar       Float?
  sodium      Float?
  
  // Micronutrients - B Vitamins
  vitaminB1   Float?   // Thiamine (mg)
  vitaminB2   Float?   // Riboflavin (mg)
  vitaminB3   Float?   // Niacin (mg)
  vitaminB5   Float?   // Pantothenic Acid (mg)
  vitaminB6   Float?   // Pyridoxine (mg)
  vitaminB12  Float?   // Cobalamin (μg)
  biotin      Float?   // Biotin (μg)
  folate      Float?   // Folate (μg)
  
  // Micronutrients - Fat-Soluble Vitamins
  vitaminA    Float?   // Retinol Activity Equivalents (μg)
  vitaminC    Float?   // Ascorbic Acid (mg)
  vitaminD    Float?   // Cholecalciferol (μg)
  vitaminK    Float?   // Phylloquinone (μg)
  
  // Micronutrients - Minerals
  calcium     Float?   // mg
  copper      Float?   // mg
  iron        Float?   // mg
  magnesium   Float?   // mg
  manganese   Float?   // mg
  phosphorus  Float?   // mg
  potassium   Float?   // mg
  selenium    Float?   // μg
  zinc        Float?   // mg
  
  // Essential Fatty Acids
  omega3      Float?   // g (EPA + DHA + ALA)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
