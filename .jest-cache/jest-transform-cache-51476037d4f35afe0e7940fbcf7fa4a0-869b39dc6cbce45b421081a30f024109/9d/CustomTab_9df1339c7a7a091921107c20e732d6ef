      sources: ["/Users/ayman/quantro/src/components/food-log/search/CustomTab.tsx"],
      sourcesContent: ["import React, { useState, useRef, useMemo, useEffect } from \"react\";\nimport Image from 'next/image';\n\ninterface CustomFood {\n  id: string;\n  name: string;\n  calories: number;\n  protein: number;\n  carbs: number;\n  fat: number;\n  fiber?: number;\n}\n\ninterface CustomTabProps {\n  customName: string;\n  setCustomName: (v: string) => void;\n  customCalories: string;\n  setCustomCalories: (v: string) => void;\n  customProtein: string;\n  setCustomProtein: (v: string) => void;\n  customCarbs: string;\n  setCustomCarbs: (v: string) => void;\n  customFat: string;\n  setCustomFat: (v: string) => void;\n  customFiber: string;\n  setCustomFiber: (v: string) => void;\n  handleAddCustomFood: () => void;\n  customFoods: CustomFood[];\n  handleAddFromCustomList: (food: CustomFood) => void;\n}\n\nexport default function CustomTab({\n  customName,\n  setCustomName,\n  customCalories,\n  setCustomCalories,\n  customProtein,\n  setCustomProtein,\n  customCarbs,\n  setCustomCarbs,\n  customFat,\n  setCustomFat,\n  customFiber,\n  setCustomFiber,\n  handleAddCustomFood,\n  customFoods,\n  handleAddFromCustomList,\n}: CustomTabProps) {\n  const [highlightedIdx, setHighlightedIdx] = useState<number>(-1);\n  const rowRefs = useRef<(HTMLTableRowElement | null)[]>([]);\n  const memoizedCustomFoods = useMemo(() => customFoods, [customFoods]);\n\n  useEffect(() => {\n    setHighlightedIdx(-1);\n  }, [memoizedCustomFoods]);\n\n  // Keyboard navigation for custom foods\n  const handleKeyDown = (e: React.KeyboardEvent<HTMLTableElement>) => {\n    if (memoizedCustomFoods.length === 0) return;\n    if (e.key === \"ArrowDown\") {\n      setHighlightedIdx((prev) => (prev + 1) % memoizedCustomFoods.length);\n      e.preventDefault();\n    } else if (e.key === \"ArrowUp\") {\n      setHighlightedIdx((prev) => (prev - 1 + memoizedCustomFoods.length) % memoizedCustomFoods.length);\n      e.preventDefault();\n    } else if (e.key === \"Enter\" && highlightedIdx >= 0) {