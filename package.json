{
  "name": "quantro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "./restart-dev.sh",
    "dev:safe": "./scripts/safe-dev-start.sh",
    "dev:check": "./scripts/check-port-3000.sh",
    "build": "prisma generate && next build",
    "build:safe": "./scripts/safe-build.sh",
    "clean": "./scripts/clean-build.sh",
    "clean:all": "./scripts/comprehensive-clean.sh",
    "maintain": "./scripts/preventive-maintenance.sh",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit --project tsconfig.test.json",
    "postinstall": "prisma generate",
    "test": "npm run test:db:setup && jest",
    "test:watch": "npm run test:db:setup && jest --watch",
    "test:coverage": "npm run test:db:setup && jest --coverage",
    "test:ci": "./scripts/ci-test-setup.sh && jest --ci --coverage --watchAll=false --forceExit --detectOpenHandles --maxWorkers=2",
    "test:fast": "./scripts/fast-test-setup.sh && jest --maxWorkers=1 --forceExit",
    "test:db:setup": "./scripts/setup-test-db.sh",
    "test:db:reset": "rm -f ./test.db && npm run test:db:setup",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "deps:check": "npm outdated",
    "deps:update": "npm update && npm audit fix",
    "deps:update-interactive": "npx npm-check-updates --interactive",
    "deps:update-all": "npx npm-check-updates -u && npm install",
    "deps:audit": "npm audit",
    "deps:audit-fix": "npm audit fix",
    "renovate:status": "renovate-config-validator"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.16.3",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react-calendar": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.1",
    "daisyui": "^5.1.26",
    "framer-motion": "^12.23.22",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "postcss": "^8.5.6",
    "prisma": "^6.16.3",
    "react": "^19.0.0",
    "react-calendar": "^6.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "resend": "^6.1.1",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
